{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "python3 .memory-seed/hooks/session-start-context.py --copilot"
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "command": "python3 .memory-seed/hooks/session-log-check.py --copilot"
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "command": "python3 .memory-seed/hooks/file-touch-decisions.py --copilot"
      }
    ]
  }
}
