{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .memory-seed/hooks/project-process-health.py --agent codex"
          },
          {
            "type": "command",
            "command": "python3 .memory-seed/hooks/session-log-check.py --codex"
          },
          {
            "type": "command",
            "command": "context-mode hook codex stop"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .memory-seed/hooks/project-process-health.py --agent codex"
          },
          {
            "type": "command",
            "command": "python3 .memory-seed/hooks/memory-retrieval-check.py --codex"
          },
          {
            "type": "command",
            "command": "context-mode hook codex userpromptsubmit"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .memory-seed/hooks/project-process-health.py --agent codex"
          },
          {
            "type": "command",
            "command": "python3 .memory-seed/hooks/session-start-context.py --codex"
          },
          {
            "type": "command",
            "command": "context-mode hook codex sessionstart"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "context-mode hook codex posttooluse"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "context-mode hook codex precompact"
          }
        ]
      }
    ]
  }
}
