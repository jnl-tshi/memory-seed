{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context-run-manifest.v1",
  "type": "object",
  "required": ["schema", "run_id", "task_id", "arm", "agent", "repetition", "schedule_seed"],
  "properties": {
    "schema": {"const": "context-run-manifest.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "pattern": "^CTX-[0-9]{2}$"},
    "arm": {"enum": ["search-mcp", "retrieval-v1-packet", "adr-candidate-packet", "adr-mcp-workflow"]},
    "agent": {"enum": ["claude", "codex"]},
    "repetition": {"type": "integer", "minimum": 1, "maximum": 3},
    "schedule_seed": {"const": 20260804}
  },
  "additionalProperties": true
}
