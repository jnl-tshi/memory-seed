{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context-query-variants.v1",
  "type": "object",
  "required": ["schema", "query_count", "source_manifest_fingerprint", "canonical_fingerprint", "queries"],
  "properties": {
    "schema": {"const": "context-query-variants.v1"},
    "query_count": {"const": 60},
    "source_manifest_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "canonical_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "queries": {
      "type": "array",
      "minItems": 60,
      "maxItems": 60,
      "items": {
        "type": "object",
        "required": ["schema", "query_id", "parent_task_id", "variant_index", "question", "fixture", "resolver_hints"],
        "properties": {
          "schema": {"const": "context-query-variant.v1"},
          "query_id": {"type": "string", "pattern": "^CTX-[0-9]{2}\\.V0[1-5]$"},
          "parent_task_id": {"type": "string", "pattern": "^CTX-[0-9]{2}$"},
          "variant_index": {"type": "integer", "minimum": 1, "maximum": 5},
          "question": {"type": "string", "minLength": 1},
          "fixture": {"type": "string", "minLength": 1},
          "resolver_hints": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
